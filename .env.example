# URL complète de la collection de lieux communiquée par le fournisseur.
EXTERNAL_API_URL=

# Facultatif. À renseigner uniquement si le fournisseur confirme le nom exact
# de l'en-tête et sa valeur (ex. Authorization avec une valeur Bearer ...).
EXTERNAL_API_AUTH_HEADER=
EXTERNAL_API_AUTH_VALUE=

# Timeout de l'appel externe (1 à 30000 ms).
EXTERNAL_API_TIMEOUT_MS=8000

# Durée du cache Next.js des fiches publiques (0 désactive le cache, max 86400).
EXTERNAL_API_REVALIDATE_SECONDS=300

# Base PostgreSQL connection string. Keep the real value in .env or .env.local.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Better Auth. Use a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# In production, set this to the public origin of the deployed application.
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Facultatif. Configurez un client OAuth Google (application Web).
# URI de redirection locale : http://localhost:3000/api/auth/callback/google
# En production : https://votre-domaine/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
